empty name: exit 255 out "" err "could not execute external process ''\n"
eacces then found: exit 0 out "from bin2 2 a b\n" err ""
eacces only: exit 255 out "" err "could not execute external process 'tool'\n"
enotdir entry: exit 0 out "from bin2 0 \n" err ""
empty entry: exit 0 out "from bin2 0 \n" err ""
relative entry after cwd: exit 0 out "from bin3\n" err ""
empty PATH: exit 0 out "from bin2 0 \n" err ""
no PATH: exit 0 out "default path\n" err ""
slash relative after cwd: exit 0 out "from bin3\n" err ""
directory: exit 255 out "" err "could not execute external process '/tmp'\n"
not executable with slash: exit 255 out "" err "could not execute external process 'bin1/tool'\n"
long name: exit 255 out "" err "could not execute external process ''\n"
nul in cmd: exit 0 out "nul cmd\n" err ""
nul in cwd: exit 0 out "work\n" err ""
nul in bad cwd: exit 255 out "" err "could not change directory to missing\n"
nul in env name: exit 0 out "[unset][v]\n" err ""
