timing what `lean_runtime::semantics::string::utf8_strlen` mirrors, through Lean's API.
NOT COMPARABLE: String.length reads the count cached in the string object, in Lean and in
every translator; utf8_strlen is the count a translator caches when it makes a string
-/
import Bench.Harness

open Bench

namespace Bench.StringUtf8Strlen

partial def loop (inp : String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (inp.length.toUInt64))
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringUtf8Strlen

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed) Bench.StringUtf8Strlen.kernel args
