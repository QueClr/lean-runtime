import Bench.Harness

namespace Bench.IsizeDiv

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (ISize.div (x).toUSize.toISize (((x <<< 17) ||| (x >>> 47))).toUSize.toISize).toUSize.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.IsizeDiv

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IsizeDiv.kernel (fun out => toString (out)) args
