timing what `lean_runtime::semantics::float32::of_bits` mirrors, through Lean's API.
one operand in eight has all exponent bits set
-/
import Bench.Harness

open Bench

namespace Bench.Float32OfBits

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Float32.ofBits (if x &&& 7 == 0 then (x >>> 32).toUInt32 ||| 0x7F800000 else (x >>> 32).toUInt32)).toBits.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Float32OfBits

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Float32OfBits.kernel args
