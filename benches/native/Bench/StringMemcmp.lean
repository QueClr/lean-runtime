/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/string_memcmp.rs`,
timing what `lean_runtime::semantics::string::memcmp` mirrors, through Lean's API.
both sides make the program's tests that supply the proofs; Lean's Array.get! retains and
releases the string it reads (an increment and a decrement of its count); the Rust side
borrows it
-/
import Bench.Harness

open Bench

namespace Bench.StringMemcmp

partial def loop (inp : Array String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((let a := inp[(x >>> 60).toNat]!; let b := inp[((x >>> 56) &&& 15).toNat]!; let l : String.Pos.Raw := ⟨(x &&& 63).toNat⟩; let n : String.Pos.Raw := ⟨512⟩; if h1 : n.offsetBy l ≤ a.rawEndPos then if h2 : n.offsetBy l ≤ b.rawEndPos then (if String.Slice.Pattern.Internal.memcmpStr a b l l n h1 h2 then 1 else 0) else 0 else 0)))
  else acc

def kernel (inp : Array String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringMemcmp

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure variants) Bench.StringMemcmp.kernel args
