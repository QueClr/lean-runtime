import Bench.Harness

open Bench

namespace Bench.Int32DecLe

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((if ((x >>> 32).toUInt32).toInt32 ≤ (x.toUInt32).toInt32 then 1 else 0)))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int32DecLe

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int32DecLe.kernel args
