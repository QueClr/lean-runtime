/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/int_compare.rs`,
timing what `lean_runtime::semantics::int::compare` mirrors, through Lean's API.
Int words in the int32 range on both sides; every result stays there; operands in 16 values,
so equal ones are frequent
-/
import Bench.Harness

open Bench

namespace Bench.IntCompare

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((match compare (((x >>> 60).toUInt32.toInt32) - 8).toInt ((((x >>> 4) &&& 15).toUInt32.toInt32) - 8).toInt with | .lt => 0 | .eq => 1 | .gt => 2)))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.IntCompare

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IntCompare.kernel args
