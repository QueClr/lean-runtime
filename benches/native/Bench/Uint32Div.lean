import Bench.Harness

namespace Bench.Uint32Div

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (UInt32.div (x >>> 32).toUInt32 x.toUInt32).toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Uint32Div

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint32Div.kernel (fun out => toString (out)) args
