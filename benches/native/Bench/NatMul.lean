/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/nat_mul.rs`,
timing what `lean_runtime::semantics::nat::mul` mirrors, through Lean's API.
Nat words on both sides (2n+1); every result stays below 2^63
-/
import Bench.Harness

open Bench

namespace Bench.NatMul

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (((x >>> 34).toNat * ((x >>> 4) &&& 0x3FFFFFFF).toNat).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.NatMul

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.NatMul.kernel args
