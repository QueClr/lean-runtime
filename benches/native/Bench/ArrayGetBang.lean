import Bench.Harness

open Bench

namespace Bench.ArrayGetBang

partial def loop (inp : Array Nat) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((inp[(x >>> 52).toNat]!).toUInt64))
  else acc

def kernel (inp : Array Nat) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ArrayGetBang

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure natOperands) Bench.ArrayGetBang.kernel args
