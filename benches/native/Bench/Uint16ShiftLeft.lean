import Bench.Harness

open Bench

namespace Bench.Uint16ShiftLeft

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((UInt16.shiftLeft (x >>> 48).toUInt16 ((x >>> 8) &&& 0xff).toUInt16).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Uint16ShiftLeft

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint16ShiftLeft.kernel args
