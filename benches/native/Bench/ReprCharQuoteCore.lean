namespace Bench.ReprCharQuoteCore

partial def loop (inp : Array Char) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Char.quoteCore inp[(x >>> 60).toNat]!).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : Array Char) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ReprCharQuoteCore

