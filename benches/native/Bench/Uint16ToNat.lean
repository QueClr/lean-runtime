/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/uint16_to_nat.rs`,
timing what `lean_runtime::semantics::uint::uint16_to_nat` mirrors, through Lean's API.
operands below 2^63, so the Nat is a scalar on both sides (a Nat word)
-/
import Bench.Harness

open Bench

namespace Bench.Uint16ToNat

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((UInt16.toNat (x >>> 48).toUInt16).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Uint16ToNat

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint16ToNat.kernel args
