import Bench.Harness

open Bench

namespace Bench.IntWriteDecimal

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int.repr (((x >>> 34).toUInt32.toInt32) - 536870912).toInt).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.IntWriteDecimal

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IntWriteDecimal.kernel args
