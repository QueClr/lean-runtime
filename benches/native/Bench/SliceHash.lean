import Bench.Harness

namespace Bench.SliceHash

partial def loop (sl : String.Slice) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop sl n (i + 1) x (acc + String.Slice.hash sl)
  else acc

def kernel (inp : String.Slice) (n : UInt64) : UInt64 :=
  let sl := inp; loop sl n 0 Bench.SEED 0

end Bench.SliceHash

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (Bench.mixed.toSlice.drop 3)) Bench.SliceHash.kernel (fun out => toString (out)) args
