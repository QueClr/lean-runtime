import Bench.Harness

open Bench

namespace Bench.SliceHash

partial def loop (inp : String.Slice) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (String.Slice.hash inp))
  else acc

def kernel (inp : String.Slice) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.SliceHash

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (mixed.toSlice.drop 3)) Bench.SliceHash.kernel args
