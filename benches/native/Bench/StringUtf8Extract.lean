import Bench.Harness

open Bench

namespace Bench.StringUtf8Extract

partial def loop (inp : PosInput) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((String.Pos.Raw.extract inp.s ⟨inp.ps[(x >>> 52).toNat]!⟩ ⟨inp.ps[((x >>> 40) &&& 4095).toNat]!⟩).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : PosInput) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringUtf8Extract

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (posInput mixed 0)) Bench.StringUtf8Extract.kernel args
