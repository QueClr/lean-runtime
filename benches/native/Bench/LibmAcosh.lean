import Bench.Harness

open Bench

namespace Bench.LibmAcosh

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Float.acosh (inp.get! (x >>> 52).toNat)).toBits))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.LibmAcosh

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (f64Operands 0x3FF0000000000000 0x4060000000000000 false)) Bench.LibmAcosh.kernel args
