    loop inp n (i + 1) x (mix acc ((Float.toUInt16 (inp.get! (x >>> 52).toNat)).toUInt64))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.FloatToUint16

