import Bench.Harness

open Bench

namespace Bench.Int16ToInt64

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int16.toInt64 ((x >>> 48).toUInt16).toInt16).toUInt64.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int16ToInt64

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int16ToInt64.kernel args
