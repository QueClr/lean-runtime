import Bench.Harness

open Bench

namespace Bench.Int64ToIntSint

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int64.toInt (x >>> 32).toUInt32.toInt32.toInt64).toInt64.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int64ToIntSint

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int64ToIntSint.kernel args
