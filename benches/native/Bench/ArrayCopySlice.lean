/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/array_copy_slice.rs`,
timing what `lean_runtime::semantics::array::copy_slice` mirrors, through Lean's API.
the array is updated in place on both sides (Lean's is unique after its first copy of the
input, the Rust twin's a copy made once); offsets anywhere in the 64-byte source and
destination, lengths up to 15, so the destination grows to at most 78 bytes
-/
import Bench.Harness

open Bench

namespace Bench.ArrayCopySlice

partial def loop (inp : ByteArray) (st : ByteArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    let st := ByteArray.copySlice inp (x >>> 58).toNat st ((x >>> 52) &&& 63).toNat ((x >>> 46) &&& 15).toNat
    loop inp st n (i + 1) x (mix acc ((st.size.toUInt64 + (st.get! ((x >>> 40) &&& 63).toNat).toUInt64)))
  else acc

def kernel (inp : ByteArray) (n : UInt64) : UInt64 :=
  loop inp (inp) n 0 SEED 0

end Bench.ArrayCopySlice

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure srcBytes) Bench.ArrayCopySlice.kernel args
