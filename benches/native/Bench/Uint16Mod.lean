import Bench.Harness

namespace Bench.Uint16Mod

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (UInt16.mod (x >>> 48).toUInt16 (x >>> 32).toUInt16).toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Uint16Mod

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint16Mod.kernel (fun out => toString (out)) args
