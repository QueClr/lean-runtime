/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/nat_pow.rs`,
timing what `lean_runtime::semantics::nat::pow` mirrors, through Lean's API.
Nat words on both sides (2n+1); every result stays below 2^63; the limit test (an exponent of
2^32 or more) is made on both sides
-/
import Bench.Harness

open Bench

namespace Bench.NatPow

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (((x >>> 60).toNat ^ ((x >>> 4) &&& 15).toNat).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.NatPow

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.NatPow.kernel args
