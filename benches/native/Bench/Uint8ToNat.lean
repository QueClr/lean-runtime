import Bench.Harness

namespace Bench.Uint8ToNat

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (UInt8.toNat (x >>> 56).toUInt8).toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Uint8ToNat

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint8ToNat.kernel (fun out => toString (out)) args
