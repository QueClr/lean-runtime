/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/hash_str.rs`,
timing what `lean_runtime::semantics::hash::hash_str` mirrors, through Lean's API.
the seed-11 call; the Rust operand passes through black_box so the hash of the fixed string is
not hoisted out of the loop
-/
import Bench.Harness

open Bench

namespace Bench.HashStr

partial def loop (inp : String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (String.hash inp))
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.HashStr

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed) Bench.HashStr.kernel args
