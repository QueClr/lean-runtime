/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/string_walk_prev_mixed.rs`,
timing what `lean_runtime::semantics::string::utf8_prev` mirrors, through Lean's API.
one iteration is a whole walk: p = prev(s, p) from a chunk end to 0, over 896 bytes of mixed
text
-/
import Bench.Harness

open Bench

namespace Bench.StringWalkPrevMixed

partial def walk (s : String) (p : String.Pos.Raw) (k : UInt64) : UInt64 :=
  if p.byteIdx == 0 then k else walk s (String.Pos.Raw.prev s p) (k + 1)

partial def loop (inp : String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (walk inp ⟨inp.utf8ByteSize - 14 * (x &&& 7).toNat⟩ 0))
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringWalkPrevMixed

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed) Bench.StringWalkPrevMixed.kernel args
