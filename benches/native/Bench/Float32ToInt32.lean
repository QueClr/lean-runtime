import Bench.Harness

open Bench

namespace Bench.Float32ToInt32

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Float32.toInt32 (inp.get! (x >>> 52).toNat).toFloat32).toUInt32.toUInt64))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Float32ToInt32

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (f64Operands 0xC1F2A05F20000000 0x4202A05F20000000 true)) Bench.Float32ToInt32.kernel args
