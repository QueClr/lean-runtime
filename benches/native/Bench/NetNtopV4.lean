/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/net_ntop_v4.rs`,
timing what `lean_runtime::semantics::net::ntop_v4` mirrors, through Lean's API.
16 addresses built before the timed region; Lean's Array.get! retains and releases the address
it reads; the result is one new string object (the Rust twin formats on the stack; Lean's C
formats with snprintf and makes the string with lean_mk_string)
-/
import Bench.Harness

open Bench

namespace Bench.NetNtopV4

partial def loop (inp : Array Std.Net.IPv4Addr) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Std.Net.IPv4Addr.toString inp[(x >>> 60).toNat]!).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : Array Std.Net.IPv4Addr) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.NetNtopV4

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ipv4Addrs) Bench.NetNtopV4.kernel args
