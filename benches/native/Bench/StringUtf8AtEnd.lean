import Bench.Harness

namespace Bench.StringUtf8AtEnd

partial def loop (s : String) (k m : UInt64) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop s k m n (i + 1) x (acc + (if String.Pos.Raw.atEnd s ⟨(x % m).toNat⟩ then 1 else 0))
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  let s := inp; let k := s.utf8ByteSize.toUInt64; let m := k + 2; loop s k m n 0 Bench.SEED 0

end Bench.StringUtf8AtEnd

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure Bench.mixed) Bench.StringUtf8AtEnd.kernel (fun out => toString (out)) args
