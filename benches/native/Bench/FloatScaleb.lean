import Bench.Harness

open Bench

namespace Bench.FloatScaleb

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Float.scaleB (inp.get! (x >>> 52).toNat) (Int.ofNat ((x >>> 8) &&& 0xfff).toNat - 2048)).toBits))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.FloatScaleb

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (f64Operands 0xC059000000000000 0x4069000000000000 false)) Bench.FloatScaleb.kernel args
