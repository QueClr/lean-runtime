timing what `lean_runtime::semantics::sint::isize_of_int` mirrors, through Lean's API.
the Int argument is an Int word, in the int32 range
-/
import Bench.Harness

open Bench

namespace Bench.IsizeOfInt

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((ISize.ofInt (Int.ofNat (x >>> 33).toNat - 1073741824)).toUSize.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.IsizeOfInt

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IsizeOfInt.kernel args
