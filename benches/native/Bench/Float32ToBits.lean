import Bench.Harness

open Bench

namespace Bench.Float32ToBits

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((inp.get! (x >>> 52).toNat).toFloat32.toBits.toUInt64))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Float32ToBits

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (f64Operands 0xC12E848000000000 0x413E848000000000 true)) Bench.Float32ToBits.kernel args
