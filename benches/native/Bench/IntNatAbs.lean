/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/int_nat_abs.rs`,
timing what `lean_runtime::semantics::int::nat_abs` mirrors, through Lean's API.
Int words in the int32 range on both sides; every result stays there
-/
import Bench.Harness

open Bench

namespace Bench.IntNatAbs

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int.natAbs (((x >>> 34).toUInt32.toInt32) - 536870912).toInt).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.IntNatAbs

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IntNatAbs.kernel args
