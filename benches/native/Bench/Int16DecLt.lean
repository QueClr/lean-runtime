import Bench.Harness

namespace Bench.Int16DecLt

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (if ((x >>> 48).toUInt16).toInt16 < ((x >>> 32).toUInt16).toInt16 then 1 else 0))
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Int16DecLt

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int16DecLt.kernel (fun out => toString (out)) args
