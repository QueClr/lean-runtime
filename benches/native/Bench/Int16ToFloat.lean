import Bench.Harness

namespace Bench.Int16ToFloat

partial def loop (n i x : UInt64) (acc : Float) : Float :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + Int16.toFloat ((x >>> 48).toUInt16).toInt16)
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float :=
  loop n 0 Bench.SEED 0.0

end Bench.Int16ToFloat

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int16ToFloat.kernel (fun out => toString (out.toBits)) args
