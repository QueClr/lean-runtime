import Bench.Harness

namespace Bench.StringUtf8ExtractFast

partial def loop (s : String) (ps : Array s.Pos) (np : UInt64) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop s ps np n (i + 1) x (acc + (String.extract (Bench.pick s ps (x % np).toNat) (Bench.pick s ps ((x >>> 32) % np).toNat)).utf8ByteSize.toUInt64)
  else acc

def kernel (inp : Bench.ValidPositions) (n : UInt64) : UInt64 :=
  let s := inp.s; let ps := inp.ps; let np := ps.size.toUInt64; loop s ps np n 0 Bench.SEED 0

end Bench.StringUtf8ExtractFast

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (Bench.validPositions Bench.mixed)) Bench.StringUtf8ExtractFast.kernel (fun out => toString (out)) args
