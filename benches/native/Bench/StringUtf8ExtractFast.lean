import Bench.Harness

open Bench

namespace Bench.StringUtf8ExtractFast

partial def loop (inp : ValidInput) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((String.extract (pick inp.s inp.ps (x >>> 52).toNat) (pick inp.s inp.ps ((x >>> 40) &&& 4095).toNat)).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : ValidInput) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringUtf8ExtractFast

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (validInput mixed)) Bench.StringUtf8ExtractFast.kernel args
