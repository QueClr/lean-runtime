import Bench.Harness

open Bench

namespace Bench.StringGetByteFast

partial def loop (inp : PosInput) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((let p : String.Pos.Raw := ⟨inp.ps[(x >>> 52).toNat]!⟩; if h : p < inp.s.rawEndPos then (String.getUTF8Byte inp.s p h).toUInt64 else 0)))
  else acc

def kernel (inp : PosInput) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringGetByteFast

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (posInput mixed 1)) Bench.StringGetByteFast.kernel args
