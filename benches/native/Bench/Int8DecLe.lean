import Bench.Harness

namespace Bench.Int8DecLe

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (if ((x >>> 56).toUInt8).toInt8 ≤ ((x >>> 48).toUInt8).toInt8 then 1 else 0))
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Int8DecLe

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int8DecLe.kernel (fun out => toString (out)) args
