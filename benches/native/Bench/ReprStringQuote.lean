/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/repr_string_quote.rs`,
timing what `lean_runtime::semantics::repr::string_quote` mirrors, through Lean's API.
Lean code natively (small strings and appends); the Rust twin formats on the stack and makes
one new string object, its characters counted; 16 strings of 30 to 60 bytes with escapes
-/
import Bench.Harness

open Bench

namespace Bench.ReprStringQuote

partial def loop (inp : Array String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((String.quote inp[(x >>> 60).toNat]!).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : Array String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ReprStringQuote

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure quoteStrings) Bench.ReprStringQuote.kernel args
