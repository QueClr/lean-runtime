import Bench.Harness

open Bench

namespace Bench.IntTmod

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int.tmod (((x >>> 34).toUInt32.toInt32) - 536870912).toInt ((((x >>> 4) &&& 0xFF).toUInt32.toInt32) - 128).toInt).toInt64.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.IntTmod

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IntTmod.kernel args
