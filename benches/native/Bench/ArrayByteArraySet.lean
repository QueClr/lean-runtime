/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/array_byte_array_set.rs`,
timing what `lean_runtime::semantics::array::byte_array_set` mirrors, through Lean's API.
the array is updated in place on both sides (Lean's is unique after its first copy of the
input, the Rust twin's a copy made once); half the indices are out of bounds (no message)
-/
import Bench.Harness

open Bench

namespace Bench.ArrayByteArraySet

partial def loop (inp : ByteArray) (st : ByteArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    let st := st.set! (x >>> 51).toNat x.toUInt8
    loop inp st n (i + 1) x (mix acc ((st.get! ((x >>> 40) &&& 4095).toNat).toUInt64))
  else acc

def kernel (inp : ByteArray) (n : UInt64) : UInt64 :=
  loop inp (inp) n 0 SEED 0

end Bench.ArrayByteArraySet

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure byteOperands) Bench.ArrayByteArraySet.kernel args
