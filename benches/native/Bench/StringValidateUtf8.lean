import Bench.Harness

open Bench

namespace Bench.StringValidateUtf8

partial def loop (inp : ByteArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((if ByteArray.validateUTF8 inp then 1 else 0)))
  else acc

def kernel (inp : ByteArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringValidateUtf8

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed.toUTF8) Bench.StringValidateUtf8.kernel args
