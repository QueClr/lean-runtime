/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/int8_to_int.rs`,
timing what `lean_runtime::semantics::sint::int8_to_int` mirrors, through Lean's API.
operands in the int32 range, so the Int is a scalar word on both sides
-/
import Bench.Harness

open Bench

namespace Bench.Int8ToInt

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int8.toInt ((x >>> 56).toUInt8).toInt8).toInt64.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int8ToInt

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int8ToInt.kernel args
