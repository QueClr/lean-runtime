import Bench.Harness

namespace Bench.Uint64ShiftLeft

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (UInt64.shiftLeft x ((x >>> 8) &&& 0xff)).toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Uint64ShiftLeft

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint64ShiftLeft.kernel (fun out => toString (out)) args
