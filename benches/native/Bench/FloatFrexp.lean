import Bench.Harness

open Bench

namespace Bench.FloatFrexp

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((match Float.frExp (inp.get! (x >>> 52).toNat) with | (m, e) => m.toBits ^^^ e.toInt64.toUInt64)))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.FloatFrexp

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (f64Operands 0xC12E848000000000 0x413E848000000000 true)) Bench.FloatFrexp.kernel args
