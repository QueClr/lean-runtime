import Bench.Harness

namespace Bench.Int32ToInt8

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (Int32.toInt8 ((x >>> 32).toUInt32).toInt32).toUInt8.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Int32ToInt8

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int32ToInt8.kernel (fun out => toString (out)) args
