import Bench.Harness

open Bench

namespace Bench.Int32ToInt8

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int32.toInt8 ((x >>> 32).toUInt32).toInt32).toUInt8.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int32ToInt8

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int32ToInt8.kernel args
