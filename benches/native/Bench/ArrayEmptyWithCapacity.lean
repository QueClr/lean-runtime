    loop inp n (i + 1) x (mix acc ((Array.mkEmpty (α := Nat) ((x >>> 4) &&& 0xFF).toNat).size.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
