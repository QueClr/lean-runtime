import Bench.Harness

open Bench

namespace Bench.ArrayAllocBytes

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((ByteArray.emptyWithCapacity ((x >>> 4) &&& 0xFF).toNat).size.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ArrayAllocBytes

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.ArrayAllocBytes.kernel args
