import Bench.Harness

open Bench

namespace Bench.Uint32OfNat

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((UInt32.ofNat (x >>> 2).toNat).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Uint32OfNat

def main (args : List String) : IO UInt32 :=
