/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/nat_div_exact.rs`,
timing what `lean_runtime::semantics::nat::div_exact, nat::mul, nat::rem` mirrors, through Lean's API.
Nat words on both sides (2n+1); every result stays below 2^63; both sides make the program's
test that supplies the proof (`b ∣ a`, a remainder)
-/
import Bench.Harness

open Bench

namespace Bench.NatDivExact

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((let b := ((x >>> 4) &&& 0xFF).toNat; let a := (x >>> 34).toNat * b; if h : b ∣ a then (Nat.divExact a b h).toUInt64 else 0)))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.NatDivExact

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.NatDivExact.kernel args
