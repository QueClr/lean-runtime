import Bench.Harness

namespace Bench.Int16ToInt

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (Int16.toInt ((x >>> 48).toUInt16).toInt16).toInt64.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Int16ToInt

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int16ToInt.kernel (fun out => toString (out)) args
