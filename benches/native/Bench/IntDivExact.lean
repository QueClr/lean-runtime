/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/int_div_exact.rs`,
timing what `lean_runtime::semantics::int::div_exact, int::mul, int::emod` mirrors, through Lean's API.
Int words in the int32 range on both sides; every result stays there; both sides make the
program's test that supplies the proof (`b ∣ a`, a remainder)
-/
import Bench.Harness

open Bench

namespace Bench.IntDivExact

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((let b := ((((x >>> 4) &&& 0xFF).toUInt32.toInt32) - 128).toInt; let a := (((x >>> 48).toUInt32.toInt32) - 32768).toInt * b; if h : b ∣ a then (Int.divExact a b h).toInt64.toUInt64 else 0)))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.IntDivExact

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IntDivExact.kernel args
