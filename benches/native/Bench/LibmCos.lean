namespace Bench.LibmCos

partial def loop (n i x : UInt64) (acc : Float) : Float :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + Float.cos (-16.0 + ((x >>> 11).toFloat * 1.1102230246251565e-16) * 32.0))
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float :=
  loop n 0 Bench.SEED 0.0

end Bench.LibmCos

def main (args : List String) : IO UInt32 :=
