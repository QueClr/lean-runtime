import Bench.Harness

namespace Bench.Int64ShiftLeft

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (Int64.shiftLeft (x).toInt64 (((x >>> 8) &&& 0xff)).toInt64).toUInt64.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Int64ShiftLeft

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int64ShiftLeft.kernel (fun out => toString (out)) args
