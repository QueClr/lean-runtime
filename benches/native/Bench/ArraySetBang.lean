/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/array_set_bang.rs`,
timing what `lean_runtime::semantics::array::set_bang` mirrors, through Lean's API.
the array is updated in place on both sides (Lean's is unique after its first copy of the
input, the Rust twin's a copy made once)
-/
import Bench.Harness

open Bench

namespace Bench.ArraySetBang

partial def loop (inp : Array Nat) (st : Array Nat) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    let st := st.set! (x >>> 52).toNat (x &&& 0xFFFF).toNat
    loop inp st n (i + 1) x (mix acc ((st[((x >>> 40) &&& 4095).toNat]!).toUInt64))
  else acc

def kernel (inp : Array Nat) (n : UInt64) : UInt64 :=
  loop inp (inp) n 0 SEED 0

end Bench.ArraySetBang

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure natOperands) Bench.ArraySetBang.kernel args
