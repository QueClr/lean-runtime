import Bench.Harness

open Bench

namespace Bench.StringUtf8GetFast

partial def loop (inp : PosInput) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((let p : String.Pos.Raw := ⟨inp.ps[(x >>> 52).toNat]!⟩; if h : String.Pos.Raw.atEnd inp.s p then 0 else (String.Pos.Raw.get' inp.s p h).val.toUInt64)))
  else acc

def kernel (inp : PosInput) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringUtf8GetFast

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (posInput mixed 1)) Bench.StringUtf8GetFast.kernel args
