import Bench.Harness

namespace Bench.Float32ToInt16

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (Float32.toInt16 ((-70000.0 + ((x >>> 11).toFloat * 1.1102230246251565e-16) * 140000.0)).toFloat32).toUInt16.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Float32ToInt16

def main (args : List String) : IO UInt32 :=
