import Bench.Harness

namespace Bench.StringLt

partial def loop (s t : String) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop s t n (i + 1) x (acc + (if decide (s < t) then 1 else 0))
  else acc

def kernel (inp : String × String) (n : UInt64) : UInt64 :=
  let s := inp.1; let t := inp.2; loop s t n 0 Bench.SEED 0

end Bench.StringLt

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (Bench.mixed, (Bench.mixed.dropEnd 1).copy.push '4')) Bench.StringLt.kernel (fun out => toString (out)) args
