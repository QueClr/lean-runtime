/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/string_lt.rs`,
timing what `lean_runtime::semantics::string::lt` mirrors, through Lean's API.
Lean's Array.get! retains and releases the string it reads (an increment and a decrement of
its count); the Rust side borrows it
-/
import Bench.Harness

open Bench

namespace Bench.StringLt

partial def loop (inp : Array String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((let a := inp[(x >>> 60).toNat]!; let b := inp[((x >>> 56) &&& 15).toNat]!; if decide (a < b) then 1 else 0)))
  else acc

def kernel (inp : Array String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringLt

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure variants) Bench.StringLt.kernel args
