import Bench.Harness

namespace Bench.Float32Frexp

partial def loop (n i x : UInt64) (acc : Float32) : Float32 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (match Float32.frExp ((-1000000.0 + ((x >>> 11).toFloat * 1.1102230246251565e-16) * 2000000.0)).toFloat32 with | (m, e) => m + e.toInt64.toFloat32))
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float32 :=
  loop n 0 Bench.SEED 0.0

end Bench.Float32Frexp

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Float32Frexp.kernel (fun out => toString (out.toBits)) args
