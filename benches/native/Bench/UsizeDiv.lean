import Bench.Harness

namespace Bench.UsizeDiv

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (USize.div (x).toUSize (((x <<< 17) ||| (x >>> 47))).toUSize).toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.UsizeDiv

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.UsizeDiv.kernel (fun out => toString (out)) args
