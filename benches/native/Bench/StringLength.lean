/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/string_length.rs`,
timing what `lean_runtime::semantics::string::length` mirrors, through Lean's API.
NOT comparable: Lean reads the count cached in the string; this counts the bytes, the count a translator caches when it makes a string.
-/
import Bench.Harness

namespace Bench.StringLength

partial def loop (s : String) (k m : UInt64) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop s k m n (i + 1) x (acc + s.length.toUInt64)
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  let s := inp; let k := s.utf8ByteSize.toUInt64; let m := k + 2; loop s k m n 0 Bench.SEED 0

end Bench.StringLength

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure Bench.mixed) Bench.StringLength.kernel (fun out => toString (out)) args
