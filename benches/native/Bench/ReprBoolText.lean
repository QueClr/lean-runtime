import Bench.Harness

open Bench

namespace Bench.ReprBoolText

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((toString (x &&& 1 == 1)).utf8ByteSize.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ReprBoolText

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.ReprBoolText.kernel args
