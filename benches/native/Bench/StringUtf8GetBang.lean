import Bench.Harness

namespace Bench.StringUtf8GetBang

partial def loop (s : String) (ps : Array Nat) (np : UInt64) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop s ps np n (i + 1) x (acc + (String.Pos.Raw.get! s ⟨ps[(x % np).toNat]!⟩).val.toUInt64)
  else acc

def kernel (inp : String × Array Nat) (n : UInt64) : UInt64 :=
  let s := inp.1; let ps := inp.2; let np := ps.size.toUInt64; loop s ps np n 0 Bench.SEED 0

end Bench.StringUtf8GetBang

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (Bench.mixed, Bench.starts Bench.mixed)) Bench.StringUtf8GetBang.kernel (fun out => toString (out)) args
