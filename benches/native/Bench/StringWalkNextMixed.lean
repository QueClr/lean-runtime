/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/string_walk_next_mixed.rs`,
timing what `lean_runtime::semantics::string::utf8_next` mirrors, through Lean's API.
one iteration is a whole walk: p = next(s, p) from a chunk start to the end, over 896 bytes of
mixed text
-/
import Bench.Harness

open Bench

namespace Bench.StringWalkNextMixed

partial def walk (s : String) (p : String.Pos.Raw) (k : UInt64) : UInt64 :=
  if String.Pos.Raw.atEnd s p then k else walk s (String.Pos.Raw.next s p) (k + 1)

partial def loop (inp : String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (walk inp ⟨14 * (x &&& 7).toNat⟩ 0))
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringWalkNextMixed

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed) Bench.StringWalkNextMixed.kernel args
