import Bench.Harness

namespace Bench.LibmSinhf

partial def loop (n i x : UInt64) (acc : Float32) : Float32 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + Float32.sinh ((-16.0 + ((x >>> 11).toFloat * 1.1102230246251565e-16) * 32.0)).toFloat32)
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float32 :=
  loop n 0 Bench.SEED 0.0

end Bench.LibmSinhf

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.LibmSinhf.kernel (fun out => toString (out.toBits)) args
