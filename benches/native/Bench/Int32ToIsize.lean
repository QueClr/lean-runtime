import Bench.Harness

open Bench

namespace Bench.Int32ToIsize

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int32.toISize ((x >>> 32).toUInt32).toInt32).toUSize.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int32ToIsize

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int32ToIsize.kernel args
