import Bench.Harness

open Bench

namespace Bench.Int16ShiftRight

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int16.shiftRight ((x >>> 48).toUInt16).toInt16 (((x >>> 8) &&& 0xff).toUInt16).toInt16).toUInt16.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int16ShiftRight

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int16ShiftRight.kernel args
