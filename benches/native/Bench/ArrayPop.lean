/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/array_pop.rs`,
timing what `lean_runtime::semantics::array::pop` mirrors, through Lean's API.
the array is updated in place on both sides (Lean's is unique after its first copy of the
input, the Rust twin's a copy made once); each iteration pops and pushes one element
-/
import Bench.Harness

open Bench

namespace Bench.ArrayPop

partial def loop (inp : Array Nat) (st : Array Nat) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    let st := st.pop.push (x >>> 40).toNat
    loop inp st n (i + 1) x (mix acc ((st[((x >>> 40) &&& 4095).toNat]!).toUInt64))
  else acc

def kernel (inp : Array Nat) (n : UInt64) : UInt64 :=
  loop inp (inp) n 0 SEED 0

end Bench.ArrayPop

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure natOperands) Bench.ArrayPop.kernel args
