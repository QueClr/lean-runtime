-/
import Bench.Harness

open Bench

namespace Bench.StringHash

partial def loop (inp : String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (String.hash inp))
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.StringHash

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed) Bench.StringHash.kernel args
