import Bench.Harness

namespace Bench.StringHash

partial def loop (s : String) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop s n (i + 1) x (acc + String.hash s)
  else acc

def kernel (inp : String) (n : UInt64) : UInt64 :=
  let s := inp; loop s n 0 Bench.SEED 0

end Bench.StringHash

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure Bench.mixed) Bench.StringHash.kernel (fun out => toString (out)) args
