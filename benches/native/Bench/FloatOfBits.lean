timing what `lean_runtime::semantics::float::of_bits` mirrors, through Lean's API.
one operand in eight has all exponent bits set
-/
import Bench.Harness

open Bench

namespace Bench.FloatOfBits

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Float.ofBits (if x &&& 7 == 0 then x ||| 0x7FF0000000000000 else x)).toBits))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.FloatOfBits

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.FloatOfBits.kernel args
