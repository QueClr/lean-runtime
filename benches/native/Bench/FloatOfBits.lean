import Bench.Harness

namespace Bench.FloatOfBits

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (if Float.ofBits x < 1.0 then 1 else 0))
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.FloatOfBits

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.FloatOfBits.kernel (fun out => toString (out)) args
