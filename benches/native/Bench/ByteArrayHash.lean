import Bench.Harness

namespace Bench.ByteArrayHash

partial def loop (b : ByteArray) (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop b n (i + 1) x (acc + ByteArray.hash b)
  else acc

def kernel (inp : ByteArray) (n : UInt64) : UInt64 :=
  let b := inp; loop b n 0 Bench.SEED 0

end Bench.ByteArrayHash

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure Bench.mixed.toUTF8) Bench.ByteArrayHash.kernel (fun out => toString (out)) args
