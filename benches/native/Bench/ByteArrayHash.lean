import Bench.Harness

open Bench

namespace Bench.ByteArrayHash

partial def loop (inp : ByteArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc (ByteArray.hash inp))
  else acc

def kernel (inp : ByteArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ByteArrayHash

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure mixed.toUTF8) Bench.ByteArrayHash.kernel args
