import Bench.Harness

open Bench

namespace Bench.FloatIsnan

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((if Float.isNaN (inp.get! (x >>> 52).toNat) then 1 else 0)))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.FloatIsnan

def main (args : List String) : IO UInt32 :=
