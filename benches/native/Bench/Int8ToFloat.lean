import Bench.Harness

namespace Bench.Int8ToFloat

partial def loop (n i x : UInt64) (acc : Float) : Float :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + Int8.toFloat ((x >>> 56).toUInt8).toInt8)
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float :=
  loop n 0 Bench.SEED 0.0

end Bench.Int8ToFloat

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int8ToFloat.kernel (fun out => toString (out.toBits)) args
