import Bench.Harness

open Bench

namespace Bench.Uint64ShiftRight

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((UInt64.shiftRight x ((x >>> 8) &&& 0xff)).toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Uint64ShiftRight

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Uint64ShiftRight.kernel args
