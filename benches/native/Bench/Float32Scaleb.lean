import Bench.Harness

namespace Bench.Float32Scaleb

partial def loop (n i x : UInt64) (acc : Float32) : Float32 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + Float32.scaleB ((-100.0 + ((x >>> 11).toFloat * 1.1102230246251565e-16) * 200.0)).toFloat32 (Int.ofNat ((x >>> 8) &&& 0x7ff).toNat - 1024))
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float32 :=
  loop n 0 Bench.SEED 0.0

end Bench.Float32Scaleb

def main (args : List String) : IO UInt32 :=
