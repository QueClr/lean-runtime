/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/string_utf8_set.rs`,
timing what `lean_runtime::semantics::string::utf8_set` mirrors, through Lean's API.
the string is updated in place where it can be on both sides (Lean's is unique after its first
copy of the input): Lean's C in place for an ASCII character over an ASCII one, else a copy
into a new string; the Rust twin's glue in place for a character of the same size
(Utf8Set::write_in_place), else one new block; any position up to two past the end, characters
of 1 to 4 bytes
-/
import Bench.Harness

open Bench

namespace Bench.StringUtf8Set

partial def loop (inp : PosInput) (st : String) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    let st := String.Pos.Raw.set st ⟨inp.ps[(x >>> 52).toNat]!⟩ (match (x >>> 8) &&& 3 with | 0 => 'x' | 1 => 'é' | 2 => '€' | _ => '😀')
    loop inp st n (i + 1) x (mix acc ((st.utf8ByteSize.toUInt64 + (let p : String.Pos.Raw := ⟨((x >>> 40) &&& 511).toNat⟩; if h : p < st.rawEndPos then (String.getUTF8Byte st p h).toUInt64 else 0))))
  else acc

def kernel (inp : PosInput) (n : UInt64) : UInt64 :=
  loop inp (inp.s) n 0 SEED 0

end Bench.StringUtf8Set

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure (posInput mixed 0)) Bench.StringUtf8Set.kernel args
