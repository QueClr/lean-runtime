import Bench.Harness

namespace Bench.Int8ShiftRight

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + (Int8.shiftRight ((x >>> 56).toUInt8).toInt8 (((x >>> 8) &&& 0xff).toUInt8).toInt8).toUInt8.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.Int8ShiftRight

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int8ShiftRight.kernel (fun out => toString (out)) args
