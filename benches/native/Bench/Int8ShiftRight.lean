import Bench.Harness

open Bench

namespace Bench.Int8ShiftRight

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Int8.shiftRight ((x >>> 56).toUInt8).toInt8 (((x >>> 8) &&& 0xff).toUInt8).toInt8).toUInt8.toUInt64))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.Int8ShiftRight

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.Int8ShiftRight.kernel args
