namespace Bench.LibmTanf

partial def loop (inp : FloatArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((Float32.tan (inp.get! (x >>> 52).toNat).toFloat32).toBits.toUInt64))
  else acc

def kernel (inp : FloatArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.LibmTanf

