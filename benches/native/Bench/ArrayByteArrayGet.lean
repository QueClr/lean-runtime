import Bench.Harness

open Bench

namespace Bench.ArrayByteArrayGet

partial def loop (inp : ByteArray) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((inp.get! (x >>> 51).toNat).toUInt64))
  else acc

def kernel (inp : ByteArray) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.ArrayByteArrayGet

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure byteOperands) Bench.ArrayByteArrayGet.kernel args
