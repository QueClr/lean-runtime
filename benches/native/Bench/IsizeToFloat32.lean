import Bench.Harness

namespace Bench.IsizeToFloat32

partial def loop (n i x : UInt64) (acc : Float32) : Float32 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + ISize.toFloat32 (x).toUSize.toISize)
  else acc

def kernel (_inp : Unit) (n : UInt64) : Float32 :=
  loop n 0 Bench.SEED 0.0

end Bench.IsizeToFloat32

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.IsizeToFloat32.kernel (fun out => toString (out.toBits)) args
