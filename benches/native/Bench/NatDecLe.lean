/-
Generated by `scripts/gen_benches.py`: the native twin of `benches/rust/src/bin/nat_dec_le.rs`,
timing what `lean_runtime::semantics::nat::dec_le` mirrors, through Lean's API.
Nat words on both sides (2n+1); every result stays below 2^63; operands in 16 values, so equal
ones are frequent
-/
import Bench.Harness

open Bench

namespace Bench.NatDecLe

partial def loop (inp : Unit) (n i x acc : UInt64) : UInt64 :=
  if i < n then
    let x := step x
    loop inp n (i + 1) x (mix acc ((if (x >>> 60).toNat ≤ ((x >>> 4) &&& 15).toNat then 1 else 0)))
  else acc

def kernel (inp : Unit) (n : UInt64) : UInt64 :=
  loop inp n 0 SEED 0

end Bench.NatDecLe

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.NatDecLe.kernel args
