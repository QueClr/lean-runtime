import Bench.Harness

namespace Bench.FloatToBits

partial def loop (n i x : UInt64) (acc : UInt64) : UInt64 :=
  if i < n then
    let x := Bench.step x
    loop n (i + 1) x (acc + ((-1000000.0 + ((x >>> 11).toFloat * 1.1102230246251565e-16) * 2000000.0)).toBits.toUInt64)
  else acc

def kernel (_inp : Unit) (n : UInt64) : UInt64 :=
  loop n 0 Bench.SEED 0

end Bench.FloatToBits

def main (args : List String) : IO UInt32 :=
  Bench.run (fun _ => pure ()) Bench.FloatToBits.kernel (fun out => toString (out)) args
